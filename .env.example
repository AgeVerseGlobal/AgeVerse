# Event reminder server configuration
# Generate keys with: node scripts/generate-vapid-keys.mjs
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@ageverse.global
# Optional: protects /api/event-reminders/dispatch when Vercel Cron calls it.
CRON_SECRET=

# Feedback + Contact -> Google Apps Script -> Google Sheet
# Create a Google Form with these six short-answer fields: Date & Time, Country, City, Page, Rating, Feedback.
# Put the Google Form formResponse URL and each question's entry ID below.
GOOGLE_FEEDBACK_WEB_APP_URL=
# Contact Us -> Google Form (optional overrides; defaults are built into /api/contact.js)
GOOGLE_CONTACT_FORM_ACTION_URL=https://docs.google.com/forms/d/e/1FAIpQLSeSddadUFlfKkeO-kSc5TMaYqrlKzbp72GRcBP9REd6R0CuJg/formResponse
GOOGLE_CONTACT_FORM_ENTRY_NAME=entry.1041465478
GOOGLE_CONTACT_FORM_ENTRY_EMAIL=entry.29619713
GOOGLE_CONTACT_FORM_ENTRY_SUBJECT=entry.666306291
GOOGLE_CONTACT_FORM_ENTRY_MESSAGE=entry.1929905653
GOOGLE_CONTACT_FORM_ENTRY_PAGE=entry.219928551
